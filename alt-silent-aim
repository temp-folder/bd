-- Silent Aim Raycasting & Targeting
local UserInputService = game:GetService("UserInputService")
local inflict = ReplicatedStorage:WaitForChild("gun_res", 30):WaitForChild("evt", 30):WaitForChild("inflict", 30)

local rcParams = RaycastParams.new()
rcParams.FilterType = Enum.RaycastFilterType.Exclude
rcParams.IgnoreWater = true

local function isVisiblePart(partPos, char)
    if not char or not char:IsDescendantOf(workspace) then return false end
    
    local filter = { Camera }
    if lp.Character then 
        table.insert(filter, lp.Character) 
    end
    rcParams.FilterDescendantsInstances = filter

    local rayOrigin = Camera.CFrame.Position
    local hit = workspace:Raycast(rayOrigin, partPos - rayOrigin, rcParams)
    
    if not hit then return true end
    local p = hit.Instance
    while p and p ~= workspace do
        if p == char or p:IsDescendantOf(char) or p:FindFirstChildOfClass("Humanoid") then return true end
        p = p.Parent
    end
    return false
end

local function getAimbotTarget()
    local bestPlayer, bestScore = nil, math.huge
    local viewportSize = Camera.ViewportSize
    local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    
    local targetParts = LocalAimbotConfig.TargetParts
    if not targetParts or #targetParts == 0 then 
        targetParts = {"Torso"} 
    end

    -- FIRST PASS: Identify closest target player
    for player, _ in pairs(currentValidTargets) do
        if player and player ~= lp and player.Parent == Players then
            local char = player.Character
            if char and char:IsDescendantOf(workspace) then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    for _, partName in ipairs(targetParts) do
                        local p = char:FindFirstChild(partName)
                        if p and p:IsA("BasePart") then
                            local partPos = p.Position
                            local viewportPoint, onScreen = Camera:WorldToViewportPoint(partPos)
                            if onScreen and viewportPoint.Z > 0 then
                                local screenDistance = (Vector2.new(viewportPoint.X, viewportPoint.Y) - screenCenter).Magnitude
                                if screenDistance <= LocalAimbotConfig.radius then
                                    local skip = false
                                    if LocalAimbotConfig.wallcheck then
                                        if not isVisiblePart(partPos, char) then 
                                            skip = true 
                                        end
                                    end
                                    if not skip then
                                        if screenDistance < bestScore then
                                            bestScore = screenDistance
                                            bestPlayer = player
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- SECOND PASS: Pick random target part from chosen player
    if bestPlayer and bestPlayer.Parent == Players then
        local char = bestPlayer.Character
        if char and char:IsDescendantOf(workspace) then
            local validParts = {}
            for _, partName in ipairs(targetParts) do
                local p = char:FindFirstChild(partName)
                if p and p:IsA("BasePart") then 
                    local isVisible = true
                    if LocalAimbotConfig.wallcheck then
                        if not isVisiblePart(p.Position, char) then
                            isVisible = false
                        end
                    end
                    if isVisible then
                        table.insert(validParts, p) 
                    end
                end
            end
            if #validParts > 0 then
                return bestPlayer, validParts[Random.new():NextInteger(1, #validParts)]
            end
        end
    end
    
    return nil, nil
end

local function resolveTool()
    local char = lp.Character
    if not char then return end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Tool") and c.Name ~= "Hands" then return c end
    end
end

local function fireInflict(player, part, tool)
    if not player or not part or not tool then return end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    inflict:FireServer(tool, hum, part, workspace:GetServerTimeNow(), { pos=part.Position, size=part.Size })
end

-- Fallback Manual Fire
local SA_LastFire = 0
local SA_MinInterval = 0.1

-- Setup Hook safely
local origFireServer, hookOk = nil, false
if typeof(hookfunction)=="function" and typeof(newcclosure)=="function" then
    local hookedSelf = inflict
    pcall(function()
        origFireServer = hookfunction(inflict.FireServer, newcclosure(function(self, ...)
            if LocalAimbotConfig.aimbotEnabled and self == hookedSelf then
                local hitRoll = Random.new():NextNumber(0, 100)
                if hitRoll <= LocalAimbotConfig.HitChance then
                    local success, targetPlayer, targetPart = pcall(getAimbotTarget)
                    if success and targetPlayer and targetPart and targetPart:IsDescendantOf(workspace) then
                        local targetChar = targetPlayer.Character
                        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                        if targetHum and targetHum.Health > 0 then
                            local a, b, c, d, e = ...
                            local pos = targetPart.Position
                            local size = targetPart.Size
                            return origFireServer(self, a, targetHum, targetPart, d, { pos = pos, size = size })
                        end
                    end
                end
            end
            return origFireServer(self, ...)
        end))
        hookOk = origFireServer ~= nil
    end)
end

if not hookOk then
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe or not LocalAimbotConfig.aimbotEnabled then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if UserInputService:GetFocusedTextBox() then return end
        if os.clock() - SA_LastFire < SA_MinInterval then return end
        
        local success, targetPlayer, targetPart = pcall(getAimbotTarget)
        if not success or not targetPlayer or not targetPart then return end
        local tool = resolveTool()
        if not tool then return end
        
        if Random.new():NextNumber(0, 100) <= LocalAimbotConfig.HitChance then
            SA_LastFire = os.clock()
            fireInflict(targetPlayer, targetPart, tool)
        end
    end)
end
