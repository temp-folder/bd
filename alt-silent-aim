local function parseNewHintText(text)
    local targetNumber = 1
    local content = text
    
    local targetMatch = text:match("^%[TARGET%s+%d+%]%s*")
    if targetMatch then
        targetNumber = tonumber(text:match("^%[TARGET%s+(%d+)%]"))
        content = text:sub(#targetMatch + 1)
    end
    
    content = content:match("^%s*(.-)%s*$") -- trim
    
    local taskMatch = content:match("^Their task%s*:%s*(.*)$")
    if taskMatch then
        return targetNumber, "task", taskMatch:match("^%s*(.-)%s*$")
    else
        return targetNumber, "trait", content
    end
end

local function updateMatchingHintPlayers()
    playersMatchingHints = {}

    local RSOD = lp:FindFirstChild("RSOD") or (lp:FindFirstChild("PlayerGui") and lp.PlayerGui:FindFirstChild("RSOD"))
    if not RSOD then return end
    
    local HintsScrollFrame = RSOD:FindFirstChild("HintsScrollFrame")
    if not HintsScrollFrame then return end

    local targetConditions = {}

    for _, textLabel in ipairs(HintsScrollFrame:GetChildren()) do
        if textLabel.Name == "TextLaba" and textLabel:IsA("TextLabel") then
            local text = textLabel.Text
            if text and #text > 0 then
                local targetNum, hintType, hintValue = parseNewHintText(text)
                if hintValue and #hintValue > 0 then
                    if not targetConditions[targetNum] then
                        targetConditions[targetNum] = {}
                    end
                    table.insert(targetConditions[targetNum], { type = hintType, value = hintValue })
                end
            end
        end
    end

    if next(targetConditions) == nil then return end
    if not NPCSFolder then return end

    for _, player in Players:GetPlayers() do
        if player ~= lp then
            local playerNPCModel = NPCSFolder:FindFirstChild(player.Name)
            if playerNPCModel then
                local configObject = playerNPCModel:FindFirstChild("Configuration")
                local playerMatchesAnyTarget = false

                for targetNumber, conditionsForTarget in pairs(targetConditions) do
                    local playerMatchesAllConditionsForTarget = true

                    for _, condition in ipairs(conditionsForTarget) do
                        local conditionMet = false

                        if condition.type == "task" then
                            local assignedTaskObject = playerNPCModel:FindFirstChild("AssignedTask")
                            if assignedTaskObject and assignedTaskObject:IsA("StringValue") and assignedTaskObject.Value == condition.value then
                                conditionMet = true
                            end
                        elseif condition.type == "trait" then
                            if configObject then
                                for _, configChild in ipairs(configObject:GetChildren()) do
                                    if configChild:IsA("StringValue") and configChild.Value == condition.value then
                                        conditionMet = true
                                        break
                                    end
                                end
                            end
                        end

                        if not conditionMet then
                            playerMatchesAllConditionsForTarget = false
                            break
                        end
                    end

                    if playerMatchesAllConditionsForTarget then
                        playerMatchesAnyTarget = true
                        break
                    end
                end

                if playerMatchesAnyTarget then
                    playersMatchingHints[player] = true
                end
            end
        end
    end
end

local function detectRoles()
    local everyoneHasGunConditionMet = false
    local noOneHasGunConditionMet = false
    local newHighestPriorityKillerDetected = false
    local theSingleKillerGunHolder = nil
    local specificJuggernautDetected = false
    local theSpecificJuggernautHolder = nil
